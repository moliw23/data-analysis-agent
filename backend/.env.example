# 数据分析 Agent 本地服务 —— 环境变量样例（不含真实密钥）
# 所有变量以 APP_ 前缀，由 pydantic-settings 读取（app/core/config.py）

# 监听地址与端口
APP_HOST=127.0.0.1
APP_PORT=8000

# 首次启动自动生成并写回本文件（Fernet 密钥，base64 url-safe 44 字符）
# 禁止硬编码。留空即触发自动生成。
APP_SECRET_KEY=

# SQLite 数据库文件路径（相对 backend/ 目录）
APP_DB_PATH=data/app.db

# 前端构建产物目录（SPA 静态托管），相对 backend/ 的上一级
APP_FRONTEND_DIST=../dist

# 隐私档位：strict | standard | full（默认 strict）
APP_PRIVACY_MODE=strict

# 日志级别：DEBUG | INFO | WARNING | ERROR
APP_LOG_LEVEL=INFO

# 日志文件（相对 backend/），留空则仅输出到控制台
APP_LOG_FILE=data/logs/app.log

# 开发用 CORS 白名单（逗号分隔）。生产同源，不生效但保留无害。
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000

# LLM 网关：单次上游调用超时（秒）与 fallback 尝试次数
APP_LLM_TIMEOUT_SECONDS=15
APP_LLM_MAX_ATTEMPTS=2

# 上游熔断：连续失败达到阈值后，冷却窗口内跳过该 provider
APP_BREAKER_FAIL_THRESHOLD=3
APP_BREAKER_COOLDOWN_SECONDS=60

# 调试：1 开启 uvicorn reload（生产必须为 0）
APP_RELOAD=0
